# ★★★ T26 / R2-4 收尾（Owner 裁决 ①：前置 nginx，2026-10-02）：
#   **参数化 Node 上游**，使之同时支持【Docker 服务名】与【本机/宿主机 IP】。
#
#   原实现：`server server:3000;` —— **硬编码 Docker Compose 服务名** `server`
#     ⇒ 非 Docker 环境（本机 / 裸机 / 容器外）**无法使用**该模板。
#   而 Go 上游早已参数化（`${ADMIN_BACKEND_HOST}:8888`）⇒ **两侧不一致**。
#
#   ★ 修法：新增 `${APP_BACKEND_HOST}`，默认值 `server`（**保持 Docker 行为不变**）。
#     · Docker：`APP_BACKEND_HOST=server`（或不设，走默认）
#     · 本机  ：`APP_BACKEND_HOST=127.0.0.1`
#
#   ★ nginx 的 `envsubst` 对【未定义变量】会替换成空串 ⇒ 必须在
#     docker-compose / 启动脚本里【显式提供默认值】，见 §「部署开关」。
upstream app_server {
    server ${APP_BACKEND_HOST}:3000;
    keepalive 64;
}

# ★ F1-C6：Go 管理台后端（潜客）。
#   背景：/api/ 前缀被两套后端同时使用 —— 落地页调 /api/track/*（Node:3000），
#   管理台调 /api/base/*、/api/user/*（Go:8888），故不能按前缀二分，改按 Host 分流。
#   ★ Go 由 compose 外提供（见 docker-compose.yml 的说明），故此处指向宿主机。
upstream go_server {
    server ${ADMIN_BACKEND_HOST}:8888;
    keepalive 32;
}

server {
    listen 80;
    listen 443 ssl;
    # ★ F1-C6：管理台按 Host 分流到 Go:8888。
    #   ADMIN_DOMAIN 由 docker-compose.yml 注入（environment: ADMIN_DOMAIN=...）。
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;

    root /usr/share/nginx/html;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ★★★ T26 / A-B2（审核 A 的 B2）：看板端点属【Node:3000】，不是 Go。
    #   背景：T19/T22 的三个看板端点
    #     GET /api/dashboard/device-versions
    #     GET /api/dashboard/collect-summary
    #     GET /api/dashboard/ttl-status
    #   由 Node(3000) 提供（数据源在 MongoDB；Go 侧【无 Mongo 依赖】）；
    #   而下方 `location /api/` 会【无条件剥 /api 并转发到 go_server】
    #   ⇒ 按正式方案部署后这三个端点【全部 404】（审核 A 实测）。
    #
    #   ★ 修法：为该前缀单独分流到 app_server，且【不剥 /api】
    #     （Node 侧路由自带 /api 前缀）。
    #   ★ nginx 前缀匹配取【最长者】⇒ `/api/dashboard/` 自动优先于 `/api/`。
    location /api/dashboard/ {
        proxy_pass http://app_server;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        # 看板端点需 Node 的 Cookie（accessToken）⇒ 默认透传
        proxy_pass_request_headers on;
    }

    # ★★ 关键：管理台 axios 的 baseURL=/api，且 api/*.js 里的 url 自带前缀，
    #    实际请求形如 /api/base/login、/api/user/getUserInfo、/api/api/getApiList；
    #    而 Go 侧（initialize/router.go）把 /base/*、/user/* 注册在【根路径】，
    #    sys_api.go 的组前缀才是 "api"（即 /api/*）。
    #    ⇒ 必须剥掉一层 /api，才能与 Go 的实际注册路径对齐。
    #    这样【零前端改动】，无需重新构建 03-web-admin。
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://go_server;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
    }

    # Go 侧的 /base/*、/user/* 等根路径组（若前端不经 /api 前缀直连时）
    location /base/ {
        proxy_pass http://go_server;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
    }

    location /user/ {
        proxy_pass http://go_server;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    listen 443 ssl;
    server_name ${LANDING_DOMAIN};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;

    root /usr/share/nginx/html;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options DENY;
        add_header X-Content-Type-Options nosniff;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options DENY;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://app_server;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
    }
}

server {
    listen 80;
    listen 443 ssl;
    server_name shopig.shop *.shopig.shop;

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    root /usr/share/nginx/html/shopg;

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    listen 443 ssl;
    server_name shopind.shop *.shopind.shop;

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    root /usr/share/nginx/html/shopins;

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    client_max_body_size 100m;

    location / {
        proxy_pass http://app_server;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
    }
}
