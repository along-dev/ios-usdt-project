# 镜像版本
IMAGE_VERSION=v0.0.101

# 部署配置
NGINX_PORT=80
NGINX_SSL_PORT=443
ADMIN_DOMAIN=localhost
WORKERS=2

# 数据库
MONGO_URI=mongodb://mongo:27017/gasleak
REDIS_URL=redis://redis:6379

# 日志
LOG_DIR=./logs
LOG_RETAIN_DAYS=2

# 存储
STORAGE_ROOT=./uploads

# 认证
JWT_SECRET=${JWT_SECRET}
DEFAULT_ADMIN_PASSWORD=${DEFAULT_ADMIN_PASSWORD}

# 数据导出加密
EXPORT_ENCRYPTION_KEY=${EXPORT_ENCRYPTION_KEY}

# 载荷加密（★ T91 新增部署前置 · ⛔ 本行只是<仓根模板>占位）
# ★ 必须填 64 hex、且 == 改前那个 key（指纹 sha256[:8]=9d0977d3）
# ★ 否则建频道时 fail-loud 崩；★ 填随机值 ⇒ 已加密产物全部解不开（= 变相轮换，触 Owner）
# ★ 注：实际注入位置（npm start 读 02-backend-node/.env，docker-compose 读 compose 目录 .env）是部署执行面、归 Owner
LOADER_PACK_KEY=
